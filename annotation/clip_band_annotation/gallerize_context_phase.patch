+// Load an image the same way DrawCard does: data/static URLs directly, server
+// paths through the authenticated client. Calls cb with a displayable URL.
+function loadImage(url, cb) {
+  if (!url) return;
+  if (url.startsWith('data:') || url.startsWith('blob:') || url.includes('/static/')) {
+    cb(url);
+    return;
+  }
+  const path = url.replace(/^\/gallerize/, '');
+  apiClient.get(path, { responseType: 'blob' })
+    .then(res => cb(URL.createObjectURL(res.data)))
+    .catch(err => console.error('Failed to load image:', err));
+}
+
+/*
+ContextCard: the crop next to its full frame (box drawn), for the context step.
+Same Invalid / Cancel behaviour as InvalidCard; clicking the frame enlarges it.
+*/
+class ContextCard extends React.Component {
+  constructor(props) {
+    super(props);
+    this.state = { cropUrl: null, frameUrl: null, invalid: false, zoom: false };
+  }
+
+  componentDidMount() {
+    loadImage(this.props.input.url, u => this.setState({ cropUrl: u }));
+    loadImage(this.props.input.frame_url, u => this.setState({ frameUrl: u }));
+  }
+
+  componentWillUnmount() {
+    [this.state.cropUrl, this.state.frameUrl].forEach(u => {
+      if (u && u.startsWith('blob:')) URL.revokeObjectURL(u);
+    });
+  }
+
+  getInstanceInfo() {
+    return {
+      filename: this.props.input.filename,
+      class: this.props.input.class,
+      shuffled_index: this.props.input.shuffled_index,
+      worker_id: new URLSearchParams(window.location.search).get('PROLIFIC_PID') || 'preview'
+    };
+  }
+
+  toggle() {
+    const invalid = !this.state.invalid;
+    this.setState({ invalid });
+    if (invalid) this.props.handleInvalid(this.getInstanceInfo());
+    else this.props.cancelInvalid(this.getInstanceInfo());
+  }
+
+  render() {
+    const { cropUrl, frameUrl, invalid, zoom } = this.state;
+    const crop = { maxWidth: '150px', maxHeight: '150px', margin: 'auto' };
+    const frame = { maxWidth: '200px', maxHeight: '360px', cursor: 'zoom-in', margin: 0 };
+    return (
+      <Card
+        className="single"
+        sx={{ display: 'inline-block', margin: '5px', verticalAlign: 'top',
+              outline: invalid ? '3px solid red' : 'none' }}
+      >
+        <CardContent sx={{ padding: '5px !important', width: '380px' }}>
+          <div style={{ display: 'flex', alignItems: 'center', gap: '10px', minHeight: '200px' }}>
+            <div style={{ width: '160px' }}>
+              {cropUrl ? <img src={cropUrl} style={crop} alt="crop" /> : null}
+            </div>
+            <div>
+              {frameUrl
+                ? <img src={frameUrl} style={frame} alt="frame" onClick={() => this.setState({ zoom: true })} />
+                : <div style={{ width: '200px', height: '356px', backgroundColor: '#f0f0f0' }} />}
+            </div>
+          </div>
+          <div style={{ padding: '8px 0', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
+            <span>{this.props.input.class}</span>
+            {invalid
+              ? <Button size="small" variant="outlined" onClick={() => this.toggle()}>Cancel</Button>
+              : <Button size="small" variant="contained" color="error" onClick={() => this.toggle()}>Invalid</Button>}
+          </div>
+          <Dialog open={zoom} onClose={() => this.setState({ zoom: false })} maxWidth="lg">
+            <DialogContent>
+              <img src={frameUrl} style={{ maxWidth: 'none', maxHeight: '85vh' }} alt="frame enlarged" />
+            </DialogContent>
+          </Dialog>
+        </CardContent>
+      </Card>
+    );
+  }
+}
+
 class InvalidCard extends React.Component {
